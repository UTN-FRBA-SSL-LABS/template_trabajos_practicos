# Set the default behavior for all files.
#* text=auto eol=lf

*.c text eol=lf diff=cpp whitespace=trailing-space,space-before-tab,blank-at-eol,blank-at-eof,indent-with-non-tab,incomplete-line
*.h text eol=lf diff=cpp whitespace=trailing-space,space-before-tab,blank-at-eol,blank-at-eof,indent-with-non-tab,incomplete-line
*.i text eol=lf diff=cpp whitespace=trailing-space,space-before-tab,blank-at-eol,blank-at-eof,indent-with-non-tab,incomplete-line

*.l text eol=lf whitespace=trailing-space,space-before-tab,blank-at-eol,blank-at-eof,indent-with-non-tab,incomplete-line

*.y text eol=lf whitespace=trailing-space,space-before-tab,blank-at-eol,blank-at-eof,indent-with-non-tab,incomplete-line

*.py text eol=lf diff=python

.gitattributes text eol=lf export-ignore
.gitignore text eol=lf export-ignore

GNUmakefile text eol=lf
makefile text eol=lf
Makefile text eol=lf
*.mk text eol=lf

README text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
CHANGELOG text eol=lf
VERSION text eol=lf export-subst
INSTALL text eol=lf
COPYING text eol=lf
AUTHORS text eol=lf
CREDITS text eol=lf

*.code-workspace text eol=lf

*.md text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown

*.yml text eol=lf
*.yaml text eol=lf

*.txt text eol=lf
*.TXT text eol=lf

*.sh text eol=lf diff=bash

*.bat text eol=crlf

*.ps1 text eol=crlf

*.ini text eol=lf diff=ini
*.cnf text eol=lf
*.conf text eol=lf
*.config text eol=lf
*.xml text eol=lf

*.log text eol=lf

*.json text eol=lf

*.iml text eol=lf

# Binary files.
*.dat binary
*.data binary
*.exe binary
*.aarch64 binary
*.darwin binary
*.linux binary
*.freebsd binary

# Archive files.
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.7z binary

# Document files.
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.csv text eol=lf

# Font files.
*.ttf binary
*.woff binary
*.woff2 binary

# Image files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.tif binary
*.tiff binary
*.bmp binary

# Audio files.
*.mp3 binary
*.ogg binary
*.opus binary
*.wav binary

# Video files.
*.mp4 binary
*.mov binary
*.avi binary
*.wmv binary
*.flv binary
*.mkv binary

# Subtitle files.
*.vtt text eol=lf

/.github/** export-ignore
/.github/CODEOWNERS text eol=lf

/.clang-format text eol=lf export-ignore
/.pre-commit-config.yaml export-ignore
/install_precommit.sh export-ignore
/PRECOMMIT.md eol=lf export-ignore
